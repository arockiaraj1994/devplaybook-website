---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found - dev-playbook" description="That page does not exist.">
  <section class="shell band band--flush">
    <div class="spine">
      <p class="spine__label">404</p>
      <div class="spine__body">
        <h2 class="h2">That page isn't here.</h2>
        <p>
          It may have moved, or the link may have been wrong to begin with. The
          <a href="/docs/">docs</a> and the <a href="/changelog/">changelog</a> are the two
          places worth trying.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
