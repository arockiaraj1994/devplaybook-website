---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeFlow from '../components/CodeFlow.astro';
import CopyBlock from '../components/CopyBlock.astro';

/*
 * Code samples live here rather than in the markup because Astro reads `{` in
 * templates as an expression, and these samples are full of braces.
 *
 * Every mark on the left is a comment a reviewer has actually had to write.
 */
const bare = [
  { t: '@app.get("/orders")' },
  { t: 'def get_orders(page: int = 1, size: int = 20):', flag: true },
  { t: '    rows = db.execute(' },
  { t: '        f"SELECT * FROM orders LIMIT {size} OFFSET {(page-1)*size}"', flag: true },
  { t: '    ).fetchall()' },
  { t: '    return rows', flag: true },
];

const withPlaybook = [
  { t: '@app.get("/orders", response_model=Page[OrderOut])' },
  { t: 'def list_orders(page: PageParams = Depends()) -> Page[OrderOut]:' },
  { t: '    return orders.paginate(page)' },
];

const marks = [
  'size has no ceiling, so ?size=100000 is a full table scan.',
  'The query is an f-string. Every other query in this repo is parameterised.',
  'Rows go out as they come back, so adding a column changes the public API.',
  'No test. "Done" here means the endpoint returned 200 once, by hand.',
];

const run = [
  'curl -O https://raw.githubusercontent.com/arockiaraj1994/dev-playbook/main/docker-compose.yml',
  'docker compose up -d',
];

const install = [
  '/plugin marketplace add arockiaraj1994/dev-playbook',
  '/plugin install dev-playbook@dev-playbook',
  '/dev-playbook-init',
];

const box = [
  {
    name: 'Run it with Docker',
    items: 'one Compose file, one command, on port 8420',
  },
  {
    name: 'Claude Code plugin',
    items: 'install it, run /dev-playbook-init, and it wires everything up',
  },
  {
    name: 'Reads before it writes',
    items: 'guardrails and the task workflow arrive before the first edit',
  },
  {
    name: 'Six language packs',
    items: 'go, java, kotlin, python, rust, typescript',
  },
  {
    name: 'What gets generated',
    items: 'guardrails, definition of done, architecture, git rules, task workflows',
  },
  {
    name: 'Dashboard',
    items: 'authoring wizard, four-tab editor, adoption and latency',
  },
];

const title = "dev-playbook - writing code got cheap, writing good code didn't";
const description =
  "Your agent can write a thousand lines before lunch, and still doesn't know your team's conventions. dev-playbook serves your guardrails, definition of done and per-language rules over MCP - and generates them if your repo hasn't got any.";
---

<BaseLayout title={title} description={description}>
  <!-- ------------------------------------------------------------- hero -->
  <section class="shell hero">
    <div class="hero__text">
      <h1 class="hero__title">
        <span>Writing code got <b class="hl">cheap</b>.</span>{' '}
        <span>Writing <b class="hl">good code</b> didn't.</span>{' '}
        <span>More code is the <b class="hl">expensive</b> part.</span>
      </h1>

      <p class="hero__sub">
        Your agent writes a thousand lines before lunch. None of them to your team's conventions.
        dev-playbook serves those rules over MCP, so the agent reads them before it writes.
      </p>

      <div class="hero__actions">
        <a class="btn" href="/docs/get-started/">Get started</a>
        <a class="btn btn--quiet" href="/docs/">Read the docs</a>
      </div>

      <p class="hero__clients">
        Run the server with Docker, then two commands in Claude Code. Cursor, Windsurf, Zed and any
        MCP client connect over SSE.
      </p>
    </div>
  </section>

  <!-- ------------------------------------------------------ where code goes -->
  <section class="codeflow">
    <div class="shell codeflow__inner">
      <div class="codeflow__scroll">
        <div class="codeflow__lanes">
          <CodeFlow />
        </div>
      </div>
    </div>
  </section>

  <!-- -------------------------------------------------------- comparison -->
  <section class="shell band">
    <div class="compare">
      <figure class="repo">
        <figcaption class="repo__caption"><b>A repo with no standards</b></figcaption>
        <pre class="code">{bare.map((l) => (
          <span class={l.flag ? 'code__line code__line--flagged' : 'code__line'}>{l.t}</span>
        ))}</pre>
        <ul class="marks">
          {marks.map((m) => <li>{m}</li>)}
        </ul>
      </figure>

      <figure class="repo">
        <figcaption class="repo__caption"><b>The same prompt, with dev-playbook</b></figcaption>
        <pre class="code">{withPlaybook.map((l) => (
          <span class="code__line">{l.t}</span>
        ))}</pre>
        <p class="verdict">
          Nothing to mark. It read the <code>guardrails</code>, the pagination pattern and
          the definition of done before it wrote a line, so the ceiling, the parameterised
          query, the response model and the test were never up for negotiation.
        </p>
      </figure>
    </div>
  </section>

  <!-- ------------------------------------------------------------- box -->
  <section class="shell band">
    <div class="spine">
      <p class="spine__label">In the box</p>
      <div class="spine__body">
        <div class="grid">
          {box.map((c) => (
            <div class="cell">
              <h2 class="cell__name">{c.name}</h2>
              <p class="cell__items">{c.items}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------- blog -->
  <section class="shell band">
    <div class="spine">
      <p class="spine__label">Blog</p>
      <div class="spine__body">
        <h2 class="h2">The rest is on the blog.</h2>
        <p>
          The problem it solves, how the agent asks before it writes, the tool surface, the
          template packs, the dashboard and how it runs, the enforcement model, and the design
          decisions behind each, all live on the blog and in the docs.
        </p>
        <p>
          <a href="/blog/">Read the blog</a> or browse the <a href="/docs/">docs</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------- close -->
  <section class="shell band">
    <div class="spine">
      <p class="spine__label">Install</p>
      <div class="spine__body">
        <h2 class="h2">Put it in front of your agent this afternoon.</h2>

        <p><b>1. Run the server</b> - download the Compose file and start it with Docker.</p>
        <CopyBlock lines={run} />

        <p><b>2. Connect Claude Code</b> - install the plugin and run the setup command.</p>
        <CopyBlock lines={install} />

        <p>
          <code>/dev-playbook-init</code> connects to the server, sets your standards up for the
          repo, and turns on the guardrails. Full walk-through in{' '}
          <a href="/docs/get-started/">Get started</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
