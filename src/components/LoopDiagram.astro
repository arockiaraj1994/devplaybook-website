---
/*
 * The standards loop. Four stations, clockwise, around the store they all read.
 *
 * A ring is the right shape here because the mechanism genuinely closes: what
 * the telemetry records is what you edit, and the next task starts from the
 * edited version. Numbered because it is a sequence.
 *
 * Geometry is computed rather than hardcoded - the side labels sit outside the
 * ring, so the canvas has to be wide enough for the longest of them.
 * Colours come from CSS custom properties, so it follows the theme toggle.
 */
const W = 720;
const H = 420;
const c = { x: W / 2, y: H / 2 - 5 };
const r = 130;
const core = 74;

const at = (deg: number) => ({
  x: c.x + r * Math.cos((deg * Math.PI) / 180),
  y: c.y + r * Math.sin((deg * Math.PI) / 180),
});

const round = (n: number) => Math.round(n * 10) / 10;

// Inset 14 degrees at each end so an arrow never collides with a station dot.
const arcs = [
  [-76, -14],
  [14, 76],
  [104, 166],
  [194, 256],
].map(([from, to]) => {
  const a = at(from);
  const b = at(to);
  return `M ${round(a.x)} ${round(a.y)} A ${r} ${r} 0 0 1 ${round(b.x)} ${round(b.y)}`;
});

const stations = [
  { n: '1', deg: -90, label: 'asks', sub: 'playbook_start_task', place: 'top' },
  { n: '2', deg: 0, label: 'reads', sub: 'the refs it was handed', place: 'right' },
  { n: '3', deg: 90, label: 'writes', sub: 'to the definition of done', place: 'bottom' },
  { n: '4', deg: 180, label: 'records', sub: 'which standards got read', place: 'left' },
].map((s) => {
  const p = at(s.deg);
  return {
    ...s,
    x: p.x,
    y: p.y,
    anchor: s.place === 'left' ? 'end' : s.place === 'right' ? 'start' : 'middle',
    tx: s.place === 'left' ? p.x - 18 : s.place === 'right' ? p.x + 18 : p.x,
    ty: s.place === 'top' ? p.y - 34 : s.place === 'bottom' ? p.y + 32 : p.y - 8,
  };
});
---

<figure class="loop">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="loop-title loop-desc">
    <title id="loop-title">The dev-playbook standards loop</title>
    <desc id="loop-desc">
      Four stations circle a central standards store. The agent asks with
      playbook_start_task, reads the refs it was handed, writes against the definition of
      done, and the server records which standards got read. Editing the stale ones feeds
      the next task.
    </desc>

    <defs>
      <marker id="loop-arrow" viewBox="0 0 10 10" refX="8" refY="5"
              markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" class="loop__head" />
      </marker>
    </defs>

    {/* the store everything reads */}
    <circle cx={c.x} cy={c.y} r={core} class="loop__core" />
    <text x={c.x} y={c.y - 4} class="loop__core-label" text-anchor="middle">your standards</text>
    <text x={c.x} y={c.y + 18} class="loop__core-sub" text-anchor="middle">one SQLite store</text>

    {/* the ring */}
    <circle cx={c.x} cy={c.y} r={r} class="loop__ring" />
    {arcs.map((d) => <path d={d} class="loop__arc" marker-end="url(#loop-arrow)" />)}

    {/* the stations */}
    {stations.map((s) => (
      <g>
        <circle cx={s.x} cy={s.y} r="6" class="loop__dot" />
        <text x={s.tx} y={s.ty} text-anchor={s.anchor}>
          <tspan class="loop__num">{s.n}</tspan>
          <tspan class="loop__label" dx="7">{s.label}</tspan>
        </text>
        <text x={s.tx} y={s.ty + 21} text-anchor={s.anchor} class="loop__sub">{s.sub}</text>
      </g>
    ))}
  </svg>

  <figcaption>
    The telemetry is what closes it. It shows which standards nobody has read since you wrote
    them, you edit those, and the next task opens against the better version.
  </figcaption>
</figure>

<style>
  .loop {
    margin: 0;
  }

  .loop svg {
    display: block;
    width: 100%;
    max-width: 40rem;
    height: auto;
  }

  .loop__core {
    fill: var(--accent-wash);
    stroke: var(--accent);
    stroke-width: 1;
  }

  .loop__core-label {
    fill: var(--ink);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
  }

  .loop__core-sub,
  .loop__sub {
    fill: var(--graphite);
    font-family: var(--font-body);
    font-size: 13px;
  }

  .loop__ring {
    fill: none;
    stroke: var(--hairline);
    stroke-width: 1;
    stroke-dasharray: 3 6;
  }

  .loop__arc {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .loop__head {
    fill: var(--accent);
  }

  .loop__dot {
    fill: var(--accent);
  }

  .loop__num {
    fill: var(--graphite);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .loop__label {
    fill: var(--ink);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
  }

  .loop figcaption {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--graphite);
    max-width: 52ch;
  }
</style>
