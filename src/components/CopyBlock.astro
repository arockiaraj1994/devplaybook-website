---
/** A command block you can actually take with you. */
interface Props {
  lines: string[];
}
const { lines } = Astro.props;
const text = lines.join('\n');
---

<div class="copyblock">
  <div class="install">
    {lines.map((l) => <span class="cmd">{l}</span>)}
  </div>
  <button type="button" class="copybtn" data-copy={text}>Copy</button>
</div>

<style>
  .copyblock {
    position: relative;
  }

  .copybtn {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: 4px;
    color: var(--graphite);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.4;
    padding: 0.25rem 0.6rem;
  }

  .copybtn:hover {
    color: var(--ink);
    border-color: var(--graphite);
  }

  .copybtn[data-state='done'] {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copybtn').forEach((button) => {
    button.addEventListener('click', async () => {
      const text = button.dataset.copy;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
        button.dataset.state = 'done';
      } catch {
        // Clipboard blocked (insecure origin, or the browser said no).
        button.textContent = 'Press Ctrl+C';
      }

      setTimeout(() => {
        button.textContent = 'Copy';
        delete button.dataset.state;
      }, 2000);
    });
  });
</script>
